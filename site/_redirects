# The admin dashboard is a LIVE page served by the hub backend (FastAPI on the
# VPS) — Netlify only hosts static files, so it can't run the dashboard itself.
# These rules send /admin on the Netlify domain to the real hub admin, which
# prompts for the admin password there.
/admin       https://api.hermix.dev/admin            302
/admin/*     https://api.hermix.dev/admin/:splat     302
